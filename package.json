{
  "name": "auto-commit-cli",
  "version": "2.0.0",
  "description": "🚀 自动生成 Git 提交，填充 GitHub 贡献图 - CLI 版本",
  "main": "dist/index.js",
  "bin": {
    "auto-commit": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "node --test",
    "link": "npm link",
    "unlink": "npm unlink -g auto-commit-cli"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "auto-commit",
    "git",
    "github",
    "commit",
    "contribution",
    "green-squares",
    "cli",
    "automation"
  ],
  "author": "Lynthar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lynthar/autoCommit"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
